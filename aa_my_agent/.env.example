# Main Anthropic-compatible chat endpoint
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
MODEL_ID=
# Optional fallback used after repeated 529 overload errors.
FALLBACK_MODEL_ID=

# S11 model-call recovery. Retries do not repeat tool execution.
MODEL_DEFAULT_MAX_TOKENS=8000
MODEL_ESCALATED_MAX_TOKENS=16000
MODEL_MAX_TRANSIENT_RETRIES=5
MODEL_RETRY_BASE_SECONDS=0.5
MODEL_RETRY_MAX_SECONDS=32
MODEL_MAX_CONSECUTIVE_529=3
MODEL_MAX_OUTPUT_CONTINUATIONS=2
# Emergency ceiling for one user turn's model/tool rounds; normal turns end earlier.
AGENT_MAX_TOOL_ROUNDS=60

# Optional MCP client. Servers are never selected by the model; only the local
# JSON configuration may enable them. Copy mcp/servers.example.json to
# mcp/servers.json before setting this to true.
MCP_ENABLED=false
MCP_CONFIG_PATH=mcp/servers.json
MCP_CONNECT_TIMEOUT_SECONDS=15
MCP_TOOL_TIMEOUT_SECONDS=30
MCP_MAX_OUTPUT_CHARS=50000
# Example remote provider token. Keep the real value only in .env.
TRAVEL_MAP_MCP_TOKEN=
# High-quality domestic POI, geocoding, distance, and route data.
AMAP_MAPS_API_KEY=
# Legacy Duffel flight search is disabled in mcp/servers.json. Test tokens return sandbox data.
DUFFEL_ACCESS_TOKEN=
# Flight and domestic hotel candidates via Fliggy FlyAI. A key is optional for limited trial mode.
# Install the pinned CLI runtime as described in mcp/TRAVEL_MCP_SETUP.md.
FLYAI_API_KEY=
# DingTalk calendar: internal organization app credentials and the target user's Union ID.
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CALENDAR_UNION_ID=
# Legacy Google Calendar adapter is disabled in mcp/servers.json.
# Run the OAuth setup helper only if you choose to re-enable it.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# Embedding service used by the RAG module
DASHSCOPE_API_KEY=
EMBEDDING_BASE_URL=

# Tavily web search and URL extraction
TAVILY_API_KEY=

# Online checks are read-only. Index writes only happen through sync_knowledge.
RAG_INDEX_STATUS_CHECK_INTERVAL_SECONDS=30

# Optional local Cross-Encoder reranker. Set false to return to RRF only.
RAG_ENABLE_RERANKER=true
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANKER_CANDIDATE_K=10
# Leave empty for automatic CPU/GPU selection.
RAG_RERANKER_DEVICE=

# Optional adjacent context after reranking. Neighbors never bypass evidence checks.
RAG_ENABLE_ADJACENT_CONTEXT=true
RAG_ADJACENT_WINDOW_SIZE=1
RAG_ADJACENT_MAX_TOTAL_CHARS=8000

# Public template: do not send PDF images to an external service by default.
RAG_DESCRIBE_PDF_IMAGES=false
RAG_ALLOW_ON_DEMAND_IMAGE_VERIFY=false
